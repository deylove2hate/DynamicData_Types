@page
@model DynamicData.Web.Config.After.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-section text-center py-5 mb-5">
    <div class="hero-content">
        <h1 class="display-4 fw-bold mb-4 fade-in">
            <span class="gradient-text">Dynamic</span>Data
            <span class="hero-icon">⚡</span>
        </h1>
        <p class="lead mb-4 slide-in-left" style="max-width: 600px; margin: 0 auto; color: var(--text-secondary);">
            Experience the power of dynamic web applications with ASP.NET Core.
            Build responsive forms, interactive data tables, and real-time DOM manipulation.
        </p>
        <div class="hero-stats d-flex justify-content-center gap-4 mb-4 slide-in-right">
            <div class="stat-card">
                <div class="stat-number">5</div>
                <div class="stat-label">Features</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">∞</div>
                <div class="stat-label">Possibilities</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">⚡</div>
                <div class="stat-label">Performance</div>
            </div>
        </div>
        <div class="hero-buttons">
            <a href="/ConfigExample" class="btn btn-primary btn-lg me-3">
                🚀 Get Started
            </a>
            <a href="/DtExample" class="btn btn-outline-primary btn-lg">
                📊 View Demo
            </a>
        </div>
    </div>
</div>

<!-- Features Grid -->
<div class="features-grid row g-4 mb-5">
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">⚙️</div>
            <h5 class="card-title">Dynamic Configuration</h5>
            <p class="card-text">Create forms dynamically with configurable fields, validation, and responsive layouts.</p>
            <a href="/ConfigExample" class="btn btn-primary">Explore</a>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">📊</div>
            <h5 class="card-title">Data Tables</h5>
            <p class="card-text">Display and interact with data using modern, responsive table components.</p>
            <a href="/DtExample" class="btn btn-primary">View Tables</a>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">🔍</div>
            <h5 class="card-title">Reflection</h5>
            <p class="card-text">Leverage .NET reflection to dynamically inspect and manipulate object properties.</p>
            <a href="/ReflectionExample" class="btn btn-primary">Learn More</a>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">🌐</div>
            <h5 class="card-title">DOM Manipulation</h5>
            <p class="card-text">Real-time DOM manipulation with JavaScript for interactive web experiences.</p>
            <a href="/DomExample" class="btn btn-primary">Try It</a>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">🎨</div>
            <h5 class="card-title">Modern UI</h5>
            <p class="card-text">Beautiful, responsive design with smooth animations and modern aesthetics.</p>
            <a href="#" class="btn btn-primary">Experience</a>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="feature-card card h-100 text-center p-4">
            <div class="feature-icon mb-3">🚀</div>
            <h5 class="card-title">Performance</h5>
            <p class="card-text">Optimized for speed with efficient data handling and responsive interactions.</p>
            <a href="#" class="btn btn-primary">Test Speed</a>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="cta-section text-center py-5">
    <div class="cta-card card p-5">
        <h2 class="mb-4">Ready to Build Something Amazing?</h2>
        <p class="lead mb-4">Explore the power of dynamic web development with our interactive examples.</p>
        <div class="cta-buttons">
            <a href="/ConfigExample" class="btn btn-success btn-lg me-3">
                🎯 Start Building
            </a>
            <a href="https://docs.microsoft.com/en-us/aspnet/core/" target="_blank" class="btn btn-outline-success btn-lg">
                📚 Learn ASP.NET Core
            </a>
        </div>
    </div>
</div>

<style>
.hero-section {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
    border-radius: 20px;
    padding: 3rem 2rem;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
}

.hero-section::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(102, 126, 234, 0.1) 0%, transparent 70%);
    animation: rotate 20s linear infinite;
}

@@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.gradient-text {
    background: linear-gradient(135deg, #667eea, #764ba2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-icon {
    display: inline-block;
    animation: bounce 2s infinite;
}

@@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
}

.stat-card {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    transition: var(--transition);
    backdrop-filter: blur(10px);
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

.stat-number {
    font-size: 2.5rem;
    font-weight: bold;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.feature-card {
    transition: var(--transition);
    border: none;
    background: rgba(255, 255, 255, 0.95);
}

.feature-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-hover);
}

.feature-icon {
    font-size: 3rem;
    animation: pulse 2s infinite;
}

@@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

.cta-card {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    box-shadow: var(--shadow-hover);
}

.cta-card h2 {
    color: white;
}

.cta-card .lead {
    color: rgba(255, 255, 255, 0.9);
}

.btn-outline-success {
    border-color: rgba(255, 255, 255, 0.5);
    color: white;
}

.btn-outline-success:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
    color: white;
}

@@media (max-width: 768px) {
    .hero-section {
        padding: 2rem 1rem;
    }

    .hero-stats {
        flex-direction: column;
        gap: 1rem;
    }

    .stat-card {
        padding: 1rem;
    }

    .features-grid .col-md-6 {
        margin-bottom: 1rem;
    }
}
</style>
